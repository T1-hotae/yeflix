# 배포 도메인 (OG 이미지·canonical·sitemap 의 절대 URL 기준)
# 로컬에서는 비워둬도 되고, 배포 환경에는 반드시 실제 도메인을 넣어야 공유 미리보기가 뜹니다.
NEXT_PUBLIC_SITE_URL=https://yeflix-diary.vercel.app

# TMDB API Key (https://www.themoviedb.org/settings/api) - 영화/드라마
NEXT_PUBLIC_TMDB_API_KEY=여기에_TMDB_API_키_입력

# 카카오 책 검색 REST API Key (https://developers.kakao.com) - 책
# 서버(/api/books)에서만 사용하므로 NEXT_PUBLIC_ 접두어를 붙이지 않습니다.
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키_입력

# Firebase Config (https://console.firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=여기에_Firebase_API_키_입력
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=프로젝트ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=여기에_프로젝트_ID_입력
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=프로젝트ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=여기에_Sender_ID_입력
NEXT_PUBLIC_FIREBASE_APP_ID=여기에_App_ID_입력
